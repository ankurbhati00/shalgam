{
  "name": "shalgam",
  "version": "0.1.0",
  "private": true,
  "description": "Shalgam \u2014 a multi-product Indian quick-commerce platform powered by a shared React/TypeScript design system.",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:storefront": "turbo run dev --filter=@shalgam/storefront",
    "dev:admin": "turbo run dev --filter=@shalgam/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=@shalgam/ui",
    "build-storybook": "turbo run build-storybook --filter=@shalgam/ui",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css,yaml,yml}\"",
    "check": "turbo run typecheck lint test build",
    "qa:screenshots": "node scripts/visual-qa.mjs",
    "qa:responsive": "node scripts/responsive-audit.mjs",
    "qa:flows": "node scripts/storefront-flows.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3"
  }
}
