{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@12.4.1 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.4.1 --filter @shalgam/storefront build",
  "outputDirectory": "apps/storefront/dist",
  "ignoreCommand": "npx --yes turbo-ignore @shalgam/storefront",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/mockServiceWorker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
